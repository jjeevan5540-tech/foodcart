# 📧 EMAIL CONFIGURATION (Resend, SMTP/Gmail, or Log)
# ──────────────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER options: 'auto' (Resend first, then SMTP), 'resend', 'smtp', or 'none'
EMAIL_PROVIDER=auto

# Option A: Resend (API) — Recommended for custom domains
RESEND_API_KEY=re_your_api_key_here

# Option B: SMTP (e.g. Gmail) — Great for personal testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
# IMPORTANT: For Gmail, use an "App Password", NOT your regular password!
# 1. Enable 2-Step Verification
# 2. Go to: https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password

# Common Email Sender Info
FROM_NAME=FoodCart
FROM_EMAIL=your-email@gmail.com
RESTAURANT_EMAIL=jjeevan5540@gmail.com

# ─── Razorpay (Payment) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# ─── CORS (Production) ───────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.up.railway.app

# ─── Optional: WhatsApp via CallMeBot ────────────────────────────────────────
CALLMEBOT_API_KEY=placeholder_key
