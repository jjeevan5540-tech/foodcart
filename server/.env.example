# ─── Backend Server Environment Variables (.env.example) ─────────────────────
# Copy this file to server/.env and fill in the values.
# For Railway: add these in the Railway backend service dashboard.

# ─── SMTP Email (Nodemailer) ─────────────────────────────────────────────────
# Works with Gmail, Outlook, or any SMTP provider. No domain verification needed!
#
# For Gmail:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create App Password: https://myaccount.google.com/apppasswords
#   3. Select "Mail" → copy the 16-character password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

FROM_NAME=FoodKart
FROM_EMAIL=your_gmail@gmail.com

# ─── Restaurant / Owner ──────────────────────────────────────────────────────
RESTAURANT_EMAIL=owner@example.com
RESTAURANT_PHONE=9999999999

# ─── Razorpay (Payment) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_secret

# ─── CORS (Production) ───────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.up.railway.app

# ─── WhatsApp via CallMeBot (Optional) ───────────────────────────────────────
CALLMEBOT_API_KEY=placeholder_key
