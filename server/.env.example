# ─── Backend Server Environment Variables (.env.example) ─────────────────────
# Copy this file to server/.env and fill in the values.
# For Railway: add these in the Railway backend service dashboard (not in this file).

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Get a FREE key at https://resend.com/signup
RESEND_API_KEY=re_...your_key_here

# Sender address — use onboarding@resend.dev (free tier) OR your verified custom domain
# Custom domain:  noreply@send.foodkart.com  (after DNS verifies in Resend dashboard)
FROM_EMAIL=onboarding@resend.dev

# ─── Restaurant / Owner ──────────────────────────────────────────────────────
RESTAURANT_EMAIL=your@email.com
RESTAURANT_PHONE=9999999999

# ─── Razorpay (Payment) ──────────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_secret

# ─── CORS (Production) ───────────────────────────────────────────────────────
# Set this to the URL of your Railway frontend service
# e.g. https://foodkart.up.railway.app
FRONTEND_URL=https://your-frontend.up.railway.app

# ─── WhatsApp via CallMeBot (Optional) ───────────────────────────────────────
# Get key at https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=placeholder_key
